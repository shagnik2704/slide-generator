      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slide-generator-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT j.completed_at AS \"time\",\n       u.email,\n       coalesce(j.original_filename, '?') AS file,\n       round(extract(epoch FROM (j.completed_at - j.started_at))) AS seconds\nFROM background_jobs j\nJOIN users u ON u.id = j.user_id\nWHERE j.completed_at IS NOT NULL\nORDER BY 1 DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
