    {
      "id": 26,
      "type": "table",
      "title": "Activity by user",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 69
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slide-generator-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slide-generator-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT u.email,\n       count(DISTINCT t.thread_id) AS threads,\n       count(DISTINCT j.id)        AS jobs,\n       u.last_login_at,\n       u.created_at                AS joined\nFROM users u\nLEFT JOIN script_chat_threads t ON t.user_id = u.id\nLEFT JOIN background_jobs   j ON j.user_id = u.id\nGROUP BY u.email, u.last_login_at, u.created_at\nORDER BY threads DESC, jobs DESC, u.last_login_at DESC NULLS LAST",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 27,
      "type": "table",
      "title": "Jobs per user",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 69
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slide-generator-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slide-generator-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT u.email,\n       count(*) FILTER (WHERE j.status = 'completed') AS completed,\n       count(*) FILTER (WHERE j.status = 'failed')    AS failed,\n       count(*)                                       AS total\nFROM background_jobs j\nJOIN users u ON u.id = j.user_id\nGROUP BY u.email\nORDER BY total DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 28,
      "type": "table",
      "title": "Recent activity \u2014 who did what",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 78
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "slide-generator-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "slide-generator-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t.created_at            AS \"time\",\n       u.email,\n       'script chat'             AS activity,\n       coalesce(nullif(t.title, ''), '(untitled)') AS detail,\n       t.current_stage           AS stage,\n       t.status\nFROM script_chat_threads t\nJOIN users u ON u.id = t.user_id\nUNION ALL\nSELECT j.created_at,\n       u.email,\n       'timed script',\n       coalesce(j.original_filename, '(no filename)'),\n       coalesce(j.current_stage, ''),\n       j.status\nFROM background_jobs j\nJOIN users u ON u.id = j.user_id\nORDER BY 1 DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 29,
      "type": "table",
      "title": "Transcription runtimes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 88
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
