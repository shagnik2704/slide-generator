FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --extra whisper-worker --no-cache && rm -rf ~/.cache/uv ~/.cache/pip

ENV PATH="/app/.venv/bin:$PATH"

COPY src/ ./src/

# Cache the configured model in the worker image. It is never loaded by the
# backend image or API processes.
RUN python -c "import whisper; whisper.load_model('base')"

CMD ["celery", "-A", "src.workers.celery_app:celery_app", "worker", "--loglevel=INFO", "--pool=prefork", "--concurrency=1", "--queues=whisper"]
